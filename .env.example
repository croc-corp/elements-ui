# Public URL of the site: canonical URLs, Open Graph images, the sitemap and the registry item URLs.
# Compiled into the bundles and the registry, so in a container it is also a build argument.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. A Postgres connection string turns on the anonymous statistics (page views, registry installs,
# "Was this page helpful?" answers). Without it the site records nothing. Add ?sslmode=require when the
# database is on another host. `pnpm stats` prints the numbers.
DATABASE_URL=
# Connections per server process (default 5)
DATABASE_POOL_MAX=

# Optional. Rate limits key on the client address in X-Forwarded-For. Proxies in private ranges are skipped
# automatically; list any other proxy in front of the app here (comma-separated addresses or CIDR ranges).
TRUSTED_PROXIES=
